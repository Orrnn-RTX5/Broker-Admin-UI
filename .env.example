# Copy to .env and adjust for your environment.
VITE_BACKEND_TARGET=web
VITE_API_HOST=http://backend.orrnn.com
# VITE_API_URL is accepted as a backwards-compatible alias for VITE_API_HOST.
VITE_WS_HOST=wss://testbrokerbackend.orrnn.com/ws/feed
VITE_API_HOST_EXT=http://backend.orrnn.com:8091
# VITE_API_EXT_URL is accepted as a backwards-compatible alias for VITE_API_HOST_EXT.
VITE_DEFAULT_MT5_SERVER=backend.orrnn.com
VITE_DISCOVERY_BASE_URL=https://superbackend.orrnn.com
VITE_USE_MOCK_DISCOVERY=true

# Separate FIX relay form; backend access must also be enabled explicitly.
VITE_FIX_RELAY_ENABLED=false

# Local web (localhost) sends /manager and /ext-api through the Vite proxy so
# broker CORS does not block login. The selected broker origin is also stored
# in a cookie and used as the proxy target. Force the proxy on/off if needed:
# VITE_USE_DEV_PROXY=true
# VITE_USE_DEV_PROXY=false

# Broker origins that expose manager/admin APIs without a /manager prefix.
# Match origins explicitly; other brokers retain their existing routing.
# VITE_DIRECT_MANAGER_ORIGINS=https://fxtrustbrokerbackend.orrnn.com

# Legacy GTA backend fallbacks (optional override; defaults baked in).
# Prefer HTTPS endpoints to avoid plain-HTTP fallbacks.
VITE_GTA_LEGACY_WEB_BACKEND_URL=https://fxtrustbrokerbackend.orrnn.com
VITE_GTA_LEGACY_DESKTOP_BACKEND_URL=https://fxtrustbrokerbackend.orrnn.com

# Electron packaged-build broker origins (read by electron/main.js via process.env).
# Set these to your broker's reachable origins; prefer HTTPS where TLS is available.
RTX5_API_ORIGIN=https://backend.orrnn.com
RTX5_EXT_ORIGIN=http://backend.orrnn.com:8091
RTX5_BROKER_ORIGINS=https://backend.orrnn.com,http://backend.orrnn.com:8091

# Opt-in DevTools for the packaged build (off by default). Set to 1/true only for
# on-site diagnostics; leave unset in shipped/end-user installs.
# RTX5_ENABLE_DEVTOOLS=1
