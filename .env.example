# Copy to .env and replace the broker values. This file contains public browser
# settings only. For Docker, pass the resulting .env with --env-file at runtime.
# For Electron, .env.electron changes only VITE_BACKEND_TARGET to desktop.
# GitHub deployment: store the complete configuration as the ADMIN_UI_ENV
# repository Actions secret. The workflow validates and loads it at runtime.
# Optional Actions variables ADMIN_CONTAINER_NAME, ADMIN_PORT_MAPPING and
# ADMIN_UI_ENV_FILE select the existing server target; defaults are broker-admin-ui,
# 8080:80 and ~/broker-admin-ui.env. Updating a secret requires a deployment run.

# Broker identity
VITE_BACKEND_TARGET=web
VITE_BROKER_ID=your-broker-id
VITE_BROKER_NAME=Your Broker
# VITE_BROKER_SERVER=broker-server-name

# Broker API and market feed
VITE_API_HOST=https://broker.example.com
VITE_API_HOST_EXT=https://broker.example.com
VITE_WS_HOST=wss://broker.example.com
VITE_FEED_WS_URL=wss://broker.example.com/ws/feed
VITE_FEED_STATUS_URL=https://broker.example.com/ws/feed/status
# Set false only if the broker feed accepts browser clients without a token.
VITE_FEED_SEND_TOKEN=true

# Broker server and platform services
VITE_DEFAULT_MT5_SERVER=broker.example.com
VITE_DISCOVERY_BASE_URL=https://superadmin-prod.orrnn.com
VITE_SUPER_ADMIN_API_HOST=https://superadmin-prod.orrnn.com
VITE_USE_MOCK_DISCOVERY=false

# Enable only when this broker serves manager APIs without /manager paths:
# VITE_DIRECT_MANAGER_ORIGINS=https://broker.example.com
